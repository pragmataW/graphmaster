// graphmaster plugin for OpenCode. Generated by `graphmaster install`; do not
// edit. `graphmaster uninstall` removes it.
//
// Forwards tool calls and session events to `graphmaster hook <event>
// --agent opencode`. Every failure (missing binary, timeout, bad output)
// fails open: the tool call proceeds untouched.
import { spawn, spawnSync } from "node:child_process";

const BIN = {{.Binary}};
const PRE_TOOLS = new Set({{.PreTools}});
const POST_TOOLS = new Set({{.PostTools}});
const TIMEOUT_MS = {{.Timeouts}};
const MAX_TRACKED = 512;

function hookArgs(event) {
  return ["hook", event, "--agent", "opencode"];
}

// call runs the hook synchronously and returns its parsed reply or null.
function call(event, payload, cwd) {
  try {
    const r = spawnSync(BIN, hookArgs(event), {
      cwd,
      input: JSON.stringify(payload),
      encoding: "utf8",
      stdio: ["pipe", "pipe", "ignore"],
      timeout: TIMEOUT_MS[event],
      maxBuffer: 1 << 20,
      windowsHide: true,
    });
    if (r.error || r.status !== 0 || !r.stdout || !r.stdout.trim()) return null;
    const reply = JSON.parse(r.stdout);
    return reply && typeof reply === "object" ? reply : null;
  } catch {
    return null;
  }
}

// notify runs the hook in the background without waiting for it.
function notify(event, payload, cwd) {
  try {
    const child = spawn(BIN, hookArgs(event), {
      cwd,
      stdio: ["pipe", "ignore", "ignore"],
      windowsHide: true,
    });
    const timer = setTimeout(() => {
      try { child.kill(); } catch {}
    }, TIMEOUT_MS[event]);
    if (timer.unref) timer.unref();
    child.on("error", () => clearTimeout(timer));
    child.on("exit", () => clearTimeout(timer));
    child.stdin.on("error", () => {});
    child.stdin.end(JSON.stringify(payload));
  } catch {}
}

function remember(map, key, value) {
  if (key == null || value == null) return;
  map.delete(key);
  map.set(key, value);
  if (map.size > MAX_TRACKED) map.delete(map.keys().next().value);
}

function take(map, key) {
  const value = map.get(key);
  map.delete(key);
  return value;
}

const isObject = (v) => v !== null && typeof v === "object" && !Array.isArray(v);

export const GraphmasterPlugin = async ({ directory }) => {
  const subagents = new Map(); // child session id -> { root, type }
  const taskTypes = new Map(); // session id -> subagent_type of its last task call
  const shellArgs = new Map(); // callID -> args, for tool.execute.after

  // who attributes a session to its root session and subagent.
  const who = (sessionID) => {
    const sub = subagents.get(sessionID);
    return sub
      ? { sessionID: sub.root, agentID: sessionID, agentType: sub.type }
      : { sessionID };
  };

  return {
    "tool.execute.before": async (input, output) => {
      const args = isObject(output?.args) ? output.args : {};
      if (input.tool === "task") {
        remember(taskTypes, input.sessionID, args.subagent_type);
        return;
      }
      if (POST_TOOLS.has(input.tool)) remember(shellArgs, input.callID, { ...args });
      if (!PRE_TOOLS.has(input.tool)) return;
      const reply = call("pre-tool-use", {
        ...who(input.sessionID),
        tool: input.tool,
        callID: input.callID,
        args,
        cwd: directory,
      }, directory);
      if (!reply) return;
      if (reply.action === "deny") {
        throw new Error(typeof reply.reason === "string" && reply.reason ? reply.reason : "graphmaster blocked this tool call");
      }
      if (reply.action === "allow" && isObject(reply.args) && isObject(output?.args)) {
        for (const k of Object.keys(output.args)) delete output.args[k];
        Object.assign(output.args, reply.args);
      }
    },

    "tool.execute.after": async (input) => {
      if (!POST_TOOLS.has(input.tool)) return;
      notify("post-tool-use", {
        ...who(input.sessionID),
        tool: input.tool,
        callID: input.callID,
        args: take(shellArgs, input.callID) ?? {},
        cwd: directory,
      }, directory);
    },

    "experimental.session.compacting": async (input, output) => {
      const reply = call("pre-compact", { ...who(input.sessionID), cwd: directory }, directory);
      if (reply && typeof reply.context === "string" && reply.context && Array.isArray(output?.context)) {
        output.context.push(reply.context);
      }
    },

    event: async ({ event } = {}) => {
      if (!event) return;
      if (event.type === "session.created") {
        const info = event.properties?.info;
        if (!info?.id) return;
        const cwd = info.directory || directory;
        if (!info.parentID) {
          notify("session-start", { sessionID: info.id, cwd }, directory);
          return;
        }
        const root = subagents.get(info.parentID)?.root ?? info.parentID;
        const type = take(taskTypes, info.parentID) ?? "";
        remember(subagents, info.id, { root, type });
        notify("subagent-start", { sessionID: root, agentID: info.id, agentType: type, cwd }, directory);
      } else if (event.type === "file.edited") {
        const file = event.properties?.file;
        if (file) notify("post-tool-use", { tool: "edit", args: { filePath: file }, cwd: directory }, directory);
      }
    },
  };
};
