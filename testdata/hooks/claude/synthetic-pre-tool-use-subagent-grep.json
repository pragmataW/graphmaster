{
  "agent": "claude",
  "event": "pre-tool-use",
  "cwd": "{{REPO}}",
  "env": {"CLAUDE_CODE_ENTRYPOINT": "cli", "CLAUDE_PROJECT_DIR": "{{REPO}}"},
  "stdin": {
    "session_id": "{{SESSION_ID}}",
