{
  "agent": "codex",
  "event": "pre-tool-use",
  "cwd": "{{REPO}}",
  "env": {"CODEX_SANDBOX": "seatbelt"},
  "stdin": {
    "session_id": "{{SESSION_ID}}",
    "transcript_path": "{{TRANSCRIPT_PATH}}",
    "cwd": "{{REPO}}",
    "hook_event_name": "PreToolUse",
    "model": "gpt-5-codex",
    "tool_name": "shell",
    "tool_input": {"command": ["bash", "-lc", "{{COMMAND}}"], "workdir": "{{WORKDIR}}"},
    "tool_use_id": "{{TOOL_USE_ID}}"
  }
}
