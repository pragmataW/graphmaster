{
  "$schema": "https://opencode.ai/config.json",
  // Synthetic but realistic global OpenCode config used by the adapter tests.
  "theme": "tokyonight",
  "model": "anthropic/claude-sonnet-4-5",
  "autoupdate": false,
  "plugin": ["opencode-notifier@0.4.1"],
  "permission": {
    "edit": "ask",
    "bash": {
      "git push": "ask", // never push without asking
      "*": "allow"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "sqlite": {
      "type": "local",
      "command": ["uvx", "mcp-server-sqlite", "--db-path", "/tmp/dev.db"],
      "enabled": false
    }
  },
  "agent": {
    "review": {
      "description": "Reviews diffs for bugs",
      "mode": "subagent",
      "tools": { "write": false, "edit": false }
    }
  }
}
